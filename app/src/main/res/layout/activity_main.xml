<?xml version="1.0" encoding="utf-8"?>
<!--
    The activity is now only a container.
    It no longer owns an ActionBar or a Toolbar: this design needs a custom header,
    so every destination screen draws its own (see fragment_home.xml).

    fitsSystemWindows is deliberately absent - if it were true here, this very view
    would eat the window insets and the fragment could never pad the status bar itself.
-->
<androidx.fragment.app.FragmentContainerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contentRoot"
    android:name="androidx.navigation.fragment.NavHostFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:defaultNavHost="true"
    app:navGraph="@navigation/nav_graph"
    tools:context=".MainActivity" />
