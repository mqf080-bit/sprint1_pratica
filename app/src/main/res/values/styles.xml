<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Typography ===== -->
    <style name="Text.Title" parent="">
        <item name="android:textSize">29sp</item>
        <item name="android:fontFamily">@font/jost_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineHeight">36dp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.Subtitle" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/jost_regular</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.SectionTitle" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/jost_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineHeight">21dp</item>
    </style>

    <style name="Text.Button" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/jost_semibold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Text.ServiceLabel" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/jost_medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.SeeAll" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/jost_semibold</item>
        <item name="android:textColor">@color/brand_blue</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.DateLabel" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/jost_regular</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.TimeStrong" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/jost_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.TimeNormal" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/jost_medium</item>
        <item name="android:textColor">#FF5B6371</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.DoctorName" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/jost_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.DoctorSpecialty" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/jost_regular</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ===== Shapes ===== -->
    <style name="ShapeAppearanceOverlay.Sprint1.HeaderCard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
