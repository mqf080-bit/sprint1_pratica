<?xml version="1.0" encoding="utf-8"?>
<!--
    Temporary stand-in for the user's photo.
    It is in drawable/ (not drawable-nodpi/) because a vector scales itself.
    Replace with a real photo later, or with a circle-cropped image library.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="#E7EBF1" />
        </shape>
    </item>

    <item
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp"
        android:top="7dp"
        android:drawable="@drawable/ic_account_circle" />

</layer-list>
